});

// Delete a draft (when submitted or abandoned)
app.delete("/api/registrations/draft/:id", authenticate, async (req, res) => {
  const { citizenId } = req.user;
  try {
    await db.query(
      `DELETE FROM registrations 
       WHERE registration_id = $1 AND owner_id = $2 AND is_draft = true`,
      [req.params.id, citizenId]
    );
    res.json({ success: true, message: "Draft deleted" });
  } catch (err) {
    res.status(500).json({ success: false, error: err.message });
  }
});
