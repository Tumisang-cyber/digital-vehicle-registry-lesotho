// Save or update a draft
app.post("/api/registrations/draft", authenticate, async (req, res) => {
  const { draftId, step, formData } = req.body;
  const { citizenId } = req.user;

  try {
    if (draftId) {
      // Update existing draft
      const result = await db.query(
        `UPDATE registrations 
         SET draft_data = $1, current_step = $2, updated_at = NOW()
         WHERE registration_id = $3 AND owner_id = $4 AND is_draft = true
         RETURNING registration_id, current_step, draft_data`,
        [JSON.stringify(formData), step, draftId, citizenId]
      );
      if (result.rows.length === 0) {
        return res.status(404).json({ success: false, error: "Draft not found" });
      }
      res.json({ success: true, draftId: result.rows[0].registration_id, step: result.rows[0].current_step });
    } else {
      // Create new draft
      const result = await db.query(
        `INSERT INTO registrations (owner_id, is_draft, draft_data, current_step, status)
         VALUES ($1, true, $2, $3, 'DRAFT')
         RETURNING registration_id`,
        [citizenId, JSON.stringify(formData), step]
      );
      res.json({ success: true, draftId: result.rows[0].registration_id, step });
    }
  } catch (err) {
    res.status(500).json({ success: false, error: err.message });
  }
});

